# Frontend: leave empty for local-only preview. Set the deployed API origin to enable the API client.
VITE_API_BASE_URL=

# Backend runtime
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_ORIGIN=https://your-frontend-domain.example
DB_POOL_MAX=10
